# AGENTX Gateway configuration. Copy to `.env` and fill in. Never commit `.env`.
# Docker Compose loads `.env` automatically; for local `pnpm dev`, Next.js loads it too.

# REQUIRED. Postgres connection string.
# Docker Compose overrides this for the app container to point at the bundled postgres service.
# Local dev with `docker compose -f docker-compose.dev.yml up -d`: postgres://agentx:agentx@localhost:5432/agentx
DATABASE_URL=

# REQUIRED. Base64-encoded 32-byte master key used to encrypt secrets at rest
# (provider keys, MCP headers, camera credentials). Generate with: pnpm secrets:genkey
# Losing this key makes stored secrets unrecoverable.
GATEWAY_ENCRYPTION_KEY=

# OPTIONAL. Replacement key used only by `pnpm secrets:rotate`; keep the old value in
# GATEWAY_ENCRYPTION_KEY until rotation succeeds. Generate with: pnpm secrets:genkey
NEW_GATEWAY_ENCRYPTION_KEY=

# REQUIRED. HTTP Basic auth username for the admin console.
ADMIN_USERNAME=

# REQUIRED. HTTP Basic auth password for the admin console. Use a long random value.
ADMIN_PASSWORD=

# OPTIONAL. External URL of the gateway (used for the absolute `content_url` of media),
# e.g. https://gateway.example.com. A warning is logged if this is plain http:// on a non-loopback host.
PUBLIC_BASE_URL=

# OPTIONAL. Directory for uploaded media (images up to 20 MB, videos up to 200 MB). Default: /data/media
# (a Docker volume in compose). For local `pnpm dev` use MEDIA_STORAGE_DIR=./data/media (git-ignored).
# Also back this directory up. See docs/media-content.md.
MEDIA_STORAGE_DIR=

# OPTIONAL. debug | info | warn | error. Default: info
LOG_LEVEL=

# OPTIONAL. Public domain for the Caddy TLS profile (docker compose --profile tls up),
# e.g. gateway.example.com. Required only when using that profile.
GATEWAY_DOMAIN=

# OPTIONAL. SearXNG base URL. Turns on the built-in web search tools (web_search, read_web_page,
# image_search, video_search), which each model route can then enable. With the compose `search`
# profile use http://searxng:8080. Empty: the tools do not exist. See docs/web-search.md.
SEARXNG_URL=

# OPTIONAL. SearXNG safe search sent with every query: 0 off, 1 moderate, 2 strict. Default: 1.
# A deployment setting: the model can never choose or override it.
SEARCH_SAFESEARCH=

# OPTIONAL. yt-dlp executable used to play video_search results. The Docker image bundles a
# pinned yt-dlp on PATH; set this only for local `pnpm dev` (for example C:\tools\yt-dlp.exe).
# Default: yt-dlp. Without a working yt-dlp, video_search is unavailable.
YTDLP_PATH=

# OPTIONAL, docker compose `search` profile only: secret SearXNG signs its cookies with.
# Any long random string. The instance is internal (no published port).
SEARXNG_SECRET=

# Docker Compose only (postgres service credentials). Defaults: agentx / agentx / agentx.
# The app container percent-encodes these when building DATABASE_URL, so reserved
# characters (for example / : @ %) are safe here.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# OPTIONAL, docker compose only: host port for the app. Default: 3000
GATEWAY_PORT=

# OPTIONAL, docker compose only: address the app port binds to. Default: 127.0.0.1.
# The app trusts X-Forwarded-For for admin rate limiting, so only set 0.0.0.0 when the
# port is not reachable from untrusted networks (for example a trusted LAN).
GATEWAY_BIND_ADDRESS=
